rules_version = '2';
// Csak a bolt közös fiókja olvashat és írhat. Ezt a szöveget kell bemásolni:
// Firebase konzol → Firestore Database → Rules (Szabályok) → Publish (Közzététel)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "bolt@piacbufe.hu";
    }
  }
}
