rules_version = '2';
// Ezt a szöveget kell bemásolni: Firebase konzol → Firestore Database → Rules (Szabályok) → Publish (Közzététel)
// Hozzáférés: a bolt közös fiókja, ÉS minden munkatárs, akinek az e-mail címe szerepel a Kollégák listában
// (config/main.emails) és a címét a levélben megerősítette.
service cloud.firestore {
  match /databases/{database}/documents {
    function shop() {
      return request.auth != null && request.auth.token.email == "szebekft@gmail.com";
    }
    function member() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/main).data.get("emails", []);
    }
    match /{document=**} {
      allow read, write: if shop() || member();
    }
  }
}
